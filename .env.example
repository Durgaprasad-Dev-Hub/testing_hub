# =====================================================================
# Vibe Shield AI — Environment Configuration
# =====================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =====================================================================

# ----------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------
APP_NAME="Vibe Shield AI"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------
# DATABASE — PostgreSQL (REQUIRED)
# ----------------------------------------------------------------
# Install PostgreSQL from https://www.postgresql.org/download/windows/
DATABASE_URL=postgresql://vibeuser:vibepass@localhost:5432/vibedb

# Individual components (used by Docker Compose)
POSTGRES_USER=vibeuser
POSTGRES_PASSWORD=vibepass
POSTGRES_DB=vibedb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ----------------------------------------------------------------
# FILE UPLOADS
# ----------------------------------------------------------------
# Maximum ZIP file size in bytes (default: 100 MB)
MAX_UPLOAD_SIZE=104857600

# Maximum extracted workspace size in bytes (default: 500 MB)
MAX_WORKSPACE_SIZE=524288000

# Maximum number of files in a ZIP (default: 10,000)
MAX_ZIP_FILES=10000

# Directory where uploads are stored (relative to backend/)
UPLOAD_DIR=uploads

# Directory where extracted workspaces are created (relative to backend/)
WORKSPACE_DIR=workspaces

# ----------------------------------------------------------------
# AI / LLM PROVIDER (OPTIONAL)
# ----------------------------------------------------------------
# The application works without AI configuration.
# AI features (explanations, fix proposals, RAG) require a provider.

# Provider: openai | anthropic | google | disabled
LLM_PROVIDER=disabled

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# ----------------------------------------------------------------
# QDRANT — Vector Database for RAG (OPTIONAL)
# ----------------------------------------------------------------
# Required for the Knowledge Base and RAG features.
# Install via Docker: docker run -p 6333:6333 qdrant/qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=vibe_shield_knowledge

# ----------------------------------------------------------------
# SCANNERS (OPTIONAL — detected automatically)
# ----------------------------------------------------------------
# The backend detects which scanners are installed.
# Install scanners separately; their absence is reported honestly.

# Semgrep: pip install semgrep
# Bandit:  pip install bandit
# Gitleaks: https://github.com/gitleaks/gitleaks/releases
# OSV-Scanner: https://github.com/google/osv-scanner/releases
# npm audit: included with Node.js

# Override scanner paths if not on PATH
# SEMGREP_PATH=semgrep
# BANDIT_PATH=bandit
# GITLEAKS_PATH=gitleaks
# OSV_SCANNER_PATH=osv-scanner

# ----------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-before-running

# ----------------------------------------------------------------
# CORS
# ----------------------------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------------
# WORKER / SANDBOX (OPTIONAL)
# ----------------------------------------------------------------
# Maximum time (seconds) for a scan job before timeout
SCAN_TIMEOUT=300

# Maximum time (seconds) for individual scanner execution
SCANNER_TIMEOUT=60
